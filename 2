
def add(a,b):
        return a + b
        
def subtract(a,b):
        return a - b
def multiply(a,b):
        return a * b
def divide(a,b):
        return a/b
def calculator():
        try:
            print("Select operation that you would like to perform:")
            print("1. Add")
            print("2. Subtract")
            print("3. Multiply")
            print("4. Divide")
        except ValueError:
            print("The value entered is not a number")
        except ZeroDivisionError:
            print("Error: Division by zero is not allowed")

        choice = input("Enter  a choice using the numbers 1-4 found in front of the operations: ")

        a = float(input("Enter first number: "))
        b = float(input("Enter second number: "))

        if choice == '1':
            print(a, "+", b, "=", add(a,b))

        elif choice == '2':
            print(a, "-", b, "=", subtract(a,b))

        elif choice == '3':
            print(a, "*", b, "=", multiply(a,b))

        elif choice == '4':
            print(a, "/", b, "=", divide(a,b))
        else:
            print("Invalid input")
        print("Thank you for using the calculator!")
        print("Calculator program has ended.")
calculator()
    
